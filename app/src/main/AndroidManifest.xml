<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.xc.quotewidget">

    <!-- ── 权限声明 ──────────────────────────────────────────────── -->

    <!-- API 33+ normal permission：无需用户授权，Manifest 声明即可
         在 API 33+ 设备上优先于 SCHEDULE_EXACT_ALARM 使用 -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>

    <!-- API 31-32 fallback：需用户在「设置→应用→闹钟和提醒」手动授权
         API 33+ 上系统忽略此权限（USE_EXACT_ALARM 优先） -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>

    <!-- 开机重注册闹钟 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!-- Credential Manager 需要网络 -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- ── Application ───────────────────────────────────────────── -->
    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@style/Theme.QuoteWidget"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="33">

        <!-- ── Activities ─────────────────────────────────────── -->

        <!-- 主入口：检查 session，路由到登录或主页 -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- 登录页 -->
        <activity
            android:name=".ui.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"/>

        <!-- Telegram OAuth 深链接回调
             scheme / host 与 AuthRepository.launchTelegramOAuth() 中的
             redirect_uri = "quotewidget://telegram-callback" 严格对应

             launchMode="singleTask"：确保回调时不会创建多余实例，
             并且 CCT 返回后系统将本 Activity 带到前台而非重建 -->
        <activity
            android:name=".ui.TelegramCallbackActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <!-- scheme 与 build.gradle manifestPlaceholders 中定义的 telegramCallbackScheme 一致 -->
                <data
                    android:scheme="quotewidget"
                    android:host="telegram-callback"/>
            </intent-filter>
        </activity>

        <!-- ── Receivers ──────────────────────────────────────── -->

        <!-- Glance Widget：GlanceAppWidgetReceiver 子类 -->
        <receiver
            android:name=".QuoteWidgetReceiver"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info"/>
        </receiver>

        <!-- 零点闹钟触发 -->
        <receiver
            android:name=".AlarmReceiver"
            android:exported="false"/>

        <!-- 开机重注册闹钟 -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>

        <!-- 精确闹钟权限状态变化监听（API 33+ 专属）
             当用户在系统设置中切换「闹钟和提醒」开关时触发 -->
        <receiver
            android:name=".AlarmPermissionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED"/>
            </intent-filter>
        </receiver>

    </application>
</manifest>
